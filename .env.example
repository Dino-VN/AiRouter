# Copy to .env and fill in. The binary reads .env from the working directory and
# from the directory it lives in, so a release can be one file plus this one.
#
#   cp .env.example .env
#
# .env is gitignored on purpose: it holds the database credential and the key
# that decrypts stored provider tokens.

# ---------------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------------

# PostgreSQL connection string. Neon, Supabase, RDS or a local server all work.
# DATABASE_URL is accepted as an alias.
AIHUB_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------

# Address to bind. Use 127.0.0.1:8317 to accept only local clients.
AIHUB_LISTEN=:8317

# Externally reachable base URL. Shown in the UI next to the OAuth callback
# instructions, so set it when running behind a domain or a tunnel.
# AIHUB_PUBLIC_URL=https://aihub.example.com

# Set to true only when a reverse proxy you control sets X-Forwarded-For.
# Otherwise a client can spoof its IP and dodge the login rate limit.
AIHUB_TRUST_PROXY_HEADERS=false

# ---------------------------------------------------------------------------
# Secrets
# ---------------------------------------------------------------------------
# Both are generated on first start and saved into AIHUB_DATA_DIR if left
# unset. Set them explicitly for containers or anywhere the data dir is not
# persistent: losing the encryption key makes every stored provider credential
# unreadable and all connections have to be re-authorised.
#
# Generate with:  openssl rand -hex 32

# AIHUB_ENCRYPTION_KEY=
# AIHUB_JWT_SECRET=

# Where generated secrets are written. Defaults to ~/.aihub.
# AIHUB_DATA_DIR=/var/lib/aihub

# ---------------------------------------------------------------------------
# First admin account
# ---------------------------------------------------------------------------
# Leave both unset — the default — and the web UI shows a setup screen the first
# time it is opened, which creates the administrator and signs you straight in.
#
# Set them for an unattended deployment: the account is then created before the
# server starts listening, so there is no window in which somebody else could
# claim it. Only ever acted on while the users table is empty. With a username
# but no password, one is generated and printed to the log once.
#
# The username is 3-32 characters of letters, digits, dot, underscore or hyphen,
# starting and ending with a letter or digit. Lost the password? Reset it with
#   aihub -reset-password 'admin:new-password'

# AIHUB_ADMIN_USERNAME=admin
# AIHUB_ADMIN_PASSWORD=change-me-please

# ---------------------------------------------------------------------------
# Sessions
# ---------------------------------------------------------------------------

# How long a UI access token lives before the browser silently refreshes it.
AIHUB_ACCESS_TOKEN_TTL=30m
# How long a stored login stays valid without use.
AIHUB_REFRESH_TOKEN_TTL=720h

# ---------------------------------------------------------------------------
# Upstream behaviour
# ---------------------------------------------------------------------------

# Route provider traffic through a proxy (http, https or socks5).
# AIHUB_PROXY_URL=socks5://127.0.0.1:1080

# Ceiling for a single proxied request, streaming included.
AIHUB_REQUEST_TIMEOUT=10m

# Open the loopback ports the vendor OAuth clients redirect to (Codex 1455,
# Antigravity 51121). Enable this only when a browser on THIS machine will
# complete the sign-in; on a remote server, leave it off and paste the callback
# URL into the UI instead.
AIHUB_LOCAL_OAUTH_LISTENERS=false

# ---------------------------------------------------------------------------
# Antigravity coding filter
# ---------------------------------------------------------------------------
# Screens requests bound for the Antigravity upstream for non-Antigravity
# coding-client names (Cursor, Windsurf, Claude Code, Codex, Cline, etc.) that
# appear inside the JSON `system` field. Three modes:
#
#   off      filter is disabled; every request passes through (default).
#   block    matching requests are rejected with HTTP 403 and an error of type
#            `blocked_by_antigravity_coding_filter`.
#   rewrite  matched names are replaced with "Antigravity" and the rewritten
#            request is forwarded.
#
# Matching is case-insensitive and only scans JSON fields named `system`;
# mentions in user prompts, `messages`, or any other field do not trigger the
# filter.
AIHUB_ANTIGRAVITY_FILTER_MODE=off

# Toggle the built-in keyword preset. The preset covers the major AI coding
# editors, terminal agents and general-purpose coding agents (Claude Code,
# Codex, Cursor, Windsurf, Cline, Aider, Continue.dev, Amazon Q Developer,
# JetBrains AI Assistant, Replit Agent, Devin, OpenHands, etc.). Set to false
# to rely solely on custom mappings below.
AIHUB_ANTIGRAVITY_FILTER_USE_DEFAULT_KEYWORDS=true

# Extra match:replacement pairs, comma- or newline-delimited. In block mode
# each key is an additional blocked keyword (the value is ignored). In rewrite
# mode the key is replaced with its value.
#
#   AIHUB_ANTIGRAVITY_FILTER_CUSTOM_MAPPINGS=Cursor: Antigravity, Windsurf: Antigravity
#
# Blank entries and duplicate source names are dropped.
# AIHUB_ANTIGRAVITY_FILTER_CUSTOM_MAPPINGS=

# ---------------------------------------------------------------------------
# Housekeeping
# ---------------------------------------------------------------------------

# Delete usage rows older than this many days. 0 keeps everything.
AIHUB_USAGE_RETENTION_DAYS=90
